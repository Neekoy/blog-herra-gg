---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import RecentArticles from '../components/RecentArticles.astro';
import PostFeed from '../components/PostFeed.astro';
import About from '../components/About.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import { allArticles } from '../lib/categories.js';

const posts = allArticles();
---
<BaseLayout title="blog.herra.gg — a DevOps engineer's journey into cybersecurity">
  <Navbar active="home" />
  <main id="top">
    <Hero />
    <RecentArticles posts={posts.slice(0, 3)} />
    <PostFeed posts={posts} />
    <About />
    <Newsletter />
  </main>
  <Footer />
</BaseLayout>
