---
import ArticleCard from './ArticleCard.astro';
const { posts = [] } = Astro.props;
---
<section id="recent" aria-labelledby="recent-heading" class="border-b border-slate-800">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-800 pb-5">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.25em] text-purple-400">$ cat ~/posts | head -3</p>
        <h2 id="recent-heading" class="mt-2 text-2xl font-bold tracking-tight text-slate-50 sm:text-3xl">Recent articles</h2>
      </div>
      <a href="#feed" class="inline-flex items-center gap-2 border border-slate-700 px-4 py-2 font-mono text-[12px] text-slate-300 transition-colors hover:border-green-500/40 hover:text-green-400">
        View all articles
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>

    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <li class="min-w-0"><ArticleCard post={post} /></li>
      ))}
    </ul>
  </div>
</section>
