---
const { active = 'home' } = Astro.props;
const on = 'border-b-2 border-green-400 px-3 py-2 font-medium text-green-400';
const off = 'border-b-2 border-transparent px-3 py-2 text-slate-400 transition-colors hover:border-slate-700 hover:text-slate-100';
const mOn = 'block py-2 text-green-400';
const mOff = 'block py-2 text-slate-400';
---
<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/80 backdrop-blur-md">
  <nav aria-label="Primary" class="mx-auto flex max-w-7xl items-center gap-6 px-5 py-3 lg:px-8">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <span class="grid h-9 w-9 place-items-center border border-purple-500/40 bg-purple-600/20 text-purple-300 shadow-lg shadow-purple-500/20">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
          <path d="M12 3 4.5 6v5.4c0 4.3 3.1 8.3 7.5 9.6 4.4-1.3 7.5-5.3 7.5-9.6V6L12 3Z" /><path d="m9.4 11.6 1.9 1.9 3.4-3.7" />
        </svg>
      </span>
      <span class="font-mono text-[15px] font-bold tracking-tight text-slate-100">null<span class="text-purple-400">//</span>byte</span>
    </a>

    <ul class="ml-2 hidden items-center gap-1 font-mono text-[13px] md:flex">
      <li><a href="/" data-spy="hero" data-on={on} data-off={off} class={active === 'home' ? on : off} aria-current={active === 'home' ? 'page' : undefined}>~/home</a></li>
      <li><a href="/#recent" data-spy="recent feed" data-on={on} data-off={off} class={active === 'articles' ? on : off} aria-current={active === 'articles' ? 'page' : undefined}>/articles</a></li>
      <li><a href="/#about" data-spy="about" data-on={on} data-off={off} class={active === 'about' ? on : off} aria-current={active === 'about' ? 'page' : undefined}>/about</a></li>
    </ul>

    <div class="ml-auto flex items-center gap-3">
      <p class="hidden items-center gap-2 border border-green-500/30 bg-green-500/10 px-3 py-1.5 font-mono text-[11px] font-medium uppercase tracking-widest text-green-400 shadow-lg shadow-green-500/20 sm:flex">
        <span class="nb-pulse inline-block h-1.5 w-1.5 rounded-full bg-green-400 shadow-[0_0_8px_2px_rgba(74,222,128,0.6)]"></span>
        System Status: Nominal
      </p>
      <button id="nb-menu" type="button" aria-label="Open navigation" aria-expanded="false"
        class="border border-slate-700 bg-slate-900 p-2 text-slate-300 md:hidden">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </nav>

  <ul id="nb-mobile" hidden class="border-t border-slate-800 bg-slate-950 px-5 pb-4 pt-2 font-mono text-sm md:hidden">
    <li><a href="/" data-spy="hero" data-on={mOn} data-off={mOff} class={mOn}>~/home</a></li>
    <li><a href="/#recent" data-spy="recent" data-on={mOn} data-off={mOff} class={mOff}>/articles</a></li>
    <li><a href="/#feed" data-spy="feed" data-on={mOn} data-off={mOff} class={mOff}>/archive</a></li>
    <li><a href="/#about" data-spy="about" data-on={mOn} data-off={mOff} class={mOff}>/about</a></li>
  </ul>
</header>

<script>
  const burger = document.getElementById('nb-menu');
  const panel = document.getElementById('nb-mobile');
  burger?.addEventListener('click', () => {
    const open = panel.hidden;
    panel.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
  });

  // Nav scrollspy — highlights the link owning the section in view. No-ops off the home page.
  const spied = [...document.querySelectorAll('[data-spy]')];
  const sections = [...new Set(spied.flatMap((l) => l.dataset.spy.split(' ')))]
    .map((id) => document.getElementById(id))
    .filter(Boolean);
  if (sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!hit) return;
        spied.forEach((l) => {
          const isOn = l.dataset.spy.split(' ').includes(hit.target.id);
          l.className = isOn ? l.dataset.on : l.dataset.off;
          // aria-current stays on the primary nav only, so the mobile duplicate can't announce a second one.
          if (isOn && l.closest('nav')) l.setAttribute('aria-current', 'page');
          else l.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-96px 0px -70% 0px', threshold: 0 }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
