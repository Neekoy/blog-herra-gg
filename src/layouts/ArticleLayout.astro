---
/**
 * ArticleLayout.astro — the reusable page for every /articles/*.md file.
 *
 * Each Markdown file opts in via frontmatter:
 *
 *   ---
 *   layout: ../../layouts/ArticleLayout.astro
 *   title: "Unauthenticated RCE in an edge ingress controller"
 *   description: "A header-parsing desync lets a crafted request reach the admin socket."
 *   pubDate: 2026-09-07
 *   category: "Exploits"          # Exploits | Crypto | Defensive Ops (src/lib/categories.js)
 *   heroImage: "/images/rce.jpg"  # optional — resolved against src/assets, see `heroes` below
 *   cve: "CVE-2026-41880"         # optional
 *   cvss: 9.8                     # optional
 *   tags: ["http", "kubernetes"]  # optional
 *   ---
 *
 * Astro hands this layout `frontmatter`, `headings`, `rawContent()` and `url`.
 */
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { categoryStyle, formatDate, readingTime, allArticles } from '../lib/categories.js';

const { frontmatter: fm, headings = [], rawContent, url } = Astro.props;
const c = categoryStyle(fm.category);
const minutes = fm.readingTime ?? readingTime(rawContent?.() ?? '');

/**
 * Hero images: `heroImage` is a plain frontmatter *string*, so Astro can't see it as an
 * image on its own. This glob imports every asset at build time, letting us map the
 * string onto real ImageMetadata (dimensions + hashed, optimized src).
 *
 * Keep writing `heroImage: "/images/foo.jpg"` — the file lives at src/assets/images/foo.jpg.
 * Unmatched paths fall through to `null` and the hero is simply skipped, same as before.
 */
const heroes = import.meta.glob('../assets/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const hero = fm.heroImage ? heroes[`../assets${fm.heroImage}`]?.default ?? null : null;

// Sticky TOC: h2 + h3 only, so deep nesting can't wreck the rail.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Prev / next by publication date.
const posts = allArticles();
const i = posts.findIndex((p) => p.url === url);
const newer = i > 0 ? posts[i - 1] : null;
const older = i >= 0 && i < posts.length - 1 ? posts[i + 1] : null;

const prose = [
  'prose prose-invert prose-slate max-w-none',
  'prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-slate-100',
  'prose-h2:mt-12 prose-h2:scroll-mt-24 prose-h3:scroll-mt-24',
  'prose-p:text-slate-300 prose-li:text-slate-300',
  'prose-a:text-purple-400 prose-a:no-underline hover:prose-a:text-green-400',
  'prose-strong:text-green-400',
  'prose-blockquote:border-l-2 prose-blockquote:border-red-500/50 prose-blockquote:not-italic prose-blockquote:text-slate-400',
  'prose-code:rounded-none prose-code:border prose-code:border-slate-800 prose-code:bg-slate-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.85em] prose-code:text-green-400 prose-code:before:content-none prose-code:after:content-none',
  'prose-pre:rounded-none prose-pre:border prose-pre:border-slate-800 prose-pre:bg-slate-900 prose-pre:text-slate-300',
  'prose-hr:border-slate-800 prose-th:text-slate-200 prose-img:border prose-img:border-slate-800 prose-img:rounded-none',
].join(' ');
---
<BaseLayout title={`${fm.title} — blog.herra.gg`} description={fm.description}>
  <Navbar active="articles" />

  <main>
    <article>
      <!-- ── Article header ── -->
      <header class="nb-grid border-b border-slate-800">
        <div class="mx-auto max-w-3xl px-5 pb-12 pt-14">
          <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-slate-500">
            <a href="/" class="text-slate-400 hover:text-green-400">~</a>
            <span aria-hidden="true"> / </span>
            <a href="/#feed" class="text-slate-400 hover:text-green-400">articles</a>
          </nav>

          <p class={`mt-6 font-mono text-[11px] uppercase tracking-[0.25em] ${c.rule}`}>
            {fm.category}{fm.cve && ` · ${fm.cve}`}
          </p>
          <h1 class="mt-3 text-pretty text-3xl font-bold leading-tight tracking-tight text-slate-50 sm:text-4xl">{fm.title}</h1>
          {fm.description && <p class="mt-4 text-pretty text-base leading-relaxed text-slate-400">{fm.description}</p>}

          <div class="mt-6 flex flex-wrap items-center gap-3 font-mono text-[12px] text-slate-500">
            <span class="text-slate-300">{fm.author ?? 'Neekoy'}</span><span aria-hidden="true">·</span>
            <time datetime={fm.pubDate}>{formatDate(fm.pubDate)}</time><span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {fm.cvss && <span class="border border-red-500/30 bg-red-500/10 px-2 py-0.5 text-red-400">CVSS {fm.cvss}</span>}
          </div>

          {fm.tags?.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2 font-mono text-[11px]">
              {fm.tags.map((tag) => (
                <li class="border border-slate-800 bg-slate-900/50 px-2 py-1 text-slate-400">#{tag}</li>
              ))}
            </ul>
          )}
        </div>
      </header>

      {hero && (
        <figure class="m-0 border-b border-slate-800 bg-slate-950">
          {/* layout="none" keeps the crop treatment below in charge of sizing; widths/sizes
              still emit a srcset. eager + high priority because this is the LCP element. */}
          <Image src={hero} alt={fm.heroImageAlt ?? fm.title} layout="none"
            widths={[640, 1024, 1280, 1920, 2560]} sizes="(min-width: 1280px) 1280px, 100vw"
            loading="eager" fetchpriority="high" decoding="sync"
            class="mx-auto block max-h-[28rem] w-full max-w-7xl object-cover opacity-90" />
        </figure>
      )}

      <!-- ── Body + sticky TOC ── -->
      <div class="mx-auto grid max-w-7xl gap-12 px-5 py-14 lg:grid-cols-[minmax(0,1fr)_16rem] lg:px-8">
        <div class={prose}>
          <slot />
        </div>

        {toc.length > 1 && (
          <aside aria-label="On this page" class="order-first hidden lg:order-none lg:block">
            <nav class="sticky top-24 border border-slate-800 bg-slate-900/50 p-5">
              <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-purple-400">On this page</p>
              <ul class="mt-4 space-y-2 font-mono text-[12px]">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? 'pl-4' : ''}>
                    <a href={`#${h.slug}`} data-toc-link
                      class="block border-l border-slate-800 pl-3 text-slate-400 transition-colors hover:border-green-400 hover:text-green-400">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>

      <!-- ── Prev / next ── -->
      <nav aria-label="More articles" class="border-t border-slate-800">
        <div class="mx-auto grid max-w-7xl gap-5 px-5 py-12 sm:grid-cols-2 lg:px-8">
          {older ? (
            <a href={older.url} class="group border border-slate-800 bg-slate-900/50 p-5 transition-colors hover:border-purple-500/40">
              <p class="font-mono text-[11px] uppercase tracking-widest text-slate-500">← Older</p>
              <p class="mt-2 text-base font-semibold leading-snug text-slate-100 group-hover:text-purple-300">{older.frontmatter.title}</p>
            </a>
          ) : <div class="hidden sm:block"></div>}

          {newer && (
            <a href={newer.url} class="group border border-slate-800 bg-slate-900/50 p-5 transition-colors hover:border-green-500/40 sm:text-right">
              <p class="font-mono text-[11px] uppercase tracking-widest text-slate-500">Newer →</p>
              <p class="mt-2 text-base font-semibold leading-snug text-slate-100 group-hover:text-green-300">{newer.frontmatter.title}</p>
            </a>
          )}
        </div>
      </nav>
    </article>
  </main>

  <Footer />

  <script>
    // TOC scrollspy — highlights the section currently in view. ~20 lines, no deps.
    const links = [...document.querySelectorAll('[data-toc-link]')];
    if (links.length) {
      const targets = links
        .map((l) => document.getElementById(decodeURIComponent(l.hash.slice(1))))
        .filter(Boolean);
      const ACTIVE = ['border-green-400', 'text-green-400'];
      const io = new IntersectionObserver(
        (entries) => {
          const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (!hit) return;
          links.forEach((l) => {
            const on = decodeURIComponent(l.hash.slice(1)) === hit.target.id;
            ACTIVE.forEach((c) => l.classList.toggle(c, on));
            l.classList.toggle('text-slate-400', !on);
            l.classList.toggle('border-slate-800', !on);
          });
        },
        { rootMargin: '-96px 0px -70% 0px', threshold: 0 }
      );
      targets.forEach((t) => io.observe(t));
    }
  </script>
</BaseLayout>
